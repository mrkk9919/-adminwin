# TGAdmin Configuration
# Copy this file to .env and fill in your values

# Server binding (recommended for Cloudflare Tunnel: 127.0.0.1)
TGADMIN_HOST=127.0.0.1
TGADMIN_PORT=8000

# Telegram Bot Token (get from @BotFather)
TGADMIN_BOT_TOKEN=

# Database URL (default: SQLite)
# TGADMIN_DATABASE_URL=sqlite:///app/tgadmin.db

# CORS origins for frontend access behind Cloudflare
# Example: TGADMIN_CORS_ORIGINS=https://wingdigital.fit,https://www.wingdigital.fit
TGADMIN_CORS_ORIGINS=https://wingdigital.fit,https://www.wingdigital.fit

# Debug mode
TGADMIN_DEBUG=false

# Pagination
TGADMIN_PAGE_SIZE=20
