# Wing Bank Telegram Bot — Admin Panel environment.
# Copy this file to .env and edit values.

# Telegram bot token (same one used by tgbot).
BOT_TOKEN=8845776726:AAEALSwhhDv2dfOdz6x1__xM7ffyuIWc5ms
# Alternative env name accepted by the deployment scripts/service file.
TGADMIN_BOT_TOKEN=

# Additional bot tokens (comma-separated) for multi-bot monitoring.
EXTRA_BOT_TOKENS=
TGADMIN_EXTRA_BOT_TOKENS=

# ABA BANK secondary bot token (chat relay + transaction notifications).
ABA_BOT_TOKEN=
TGADMIN_ABA_BOT_TOKEN=

# Path to the shared SQLite database used by tgbot + admin.
DATABASE_PATH=../shared.db

# Admin login credentials (JWT-protected).
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
JWT_SECRET=please-change-me-to-something-random

# SMS provider configuration. "mock" for development, "camintel" for production.
SMS_PROVIDER=mock
SMS_API_KEY=
SMS_API_SECRET=

# Server binding.
HOST=127.0.0.1
PORT=8080

# Payment callback API token (used by /orders/api/payment-confirm).
PAYMENT_API_TOKEN=

# Push API token for bot-to-admin push notification calls.
PUSH_API_TOKEN=
