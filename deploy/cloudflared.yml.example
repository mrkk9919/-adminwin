# Copy to /etc/cloudflared/config.yml and edit for your tunnel.
# The tunnel ID must match the one created with:
#   cloudflared tunnel create tgadmin

tunnel: your-tunnel-id

# Keep the credentials file in /var/lib/cloudflared so a systemd-managed
# cloudflared service can read it reliably.
credentials-file: /var/lib/cloudflared/your-tunnel-id.json

ingress:
  - hostname: wingdigital.fit
    service: http://127.0.0.1:8000
  - service: http_status:404
