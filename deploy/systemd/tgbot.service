[Unit]
Description=Wing Bank Telegram Bot
After=network.target
Wants=network-online.target

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/opt/wingbank/tgbot
EnvironmentFile=/opt/wingbank/tgbot/.env
ExecStart=/opt/wingbank/tgbot/tgbot
Restart=always
RestartSec=5s
LimitNOFILE=65536

# Security hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/wingbank/tgbot

[Install]
WantedBy=multi-user.target
