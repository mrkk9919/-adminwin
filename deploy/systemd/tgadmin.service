[Unit]
Description=Wing Bank TGAdmin API + Frontend (FastAPI)
After=network.target
Wants=network-online.target

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/opt/wingbank/tgadmin
EnvironmentFile=/opt/wingbank/tgadmin/.env
Environment=PYTHONPATH=/opt/wingbank/tgadmin
ExecStart=/opt/wingbank/tgadmin/.venv/bin/uvicorn app.main:app \
  --host 127.0.0.1 \
  --port 8000 \
  --workers 2 \
  --log-level info
Restart=always
RestartSec=5s
LimitNOFILE=65536

# Security hardening
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
