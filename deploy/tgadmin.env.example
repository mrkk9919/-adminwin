# Example environment for TGAdmin (FastAPI)
# Copy to /etc/default/tgadmin or source into system environment

# Server binding
TGADMIN_HOST=127.0.0.1
TGADMIN_PORT=8000
TGADMIN_WORKERS=2

# App configuration
TGADMIN_DEBUG=false
TGADMIN_PAGE_SIZE=20

# Database: prefer an external DB in production. Example: postgres URL
# TGADMIN_DATABASE_URL=postgresql://user:pass@localhost:5432/tgadmin
TGADMIN_DATABASE_URL=sqlite:////opt/tgadmin/app/tgadmin.db

# Telegram Bot token for admin features (keep secret)
# TGADMIN_BOT_TOKEN=123456:ABC-DEF...

# CORS allowed origins (comma separated)
TGADMIN_CORS_ORIGINS=https://admin.example.com
