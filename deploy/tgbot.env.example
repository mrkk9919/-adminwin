# Example environment for TGBot service
# Copy to /etc/default/tgbot (systemd EnvironmentFile expects KEY=VALUE lines)

# Path to config file consumed by the binary (service unit passes --config)
TGBOT_CONFIG=/etc/tgbot/config.yaml

# Bot-wide settings (optional, read by your deployment scripts or the binary)
TGBOT_WORKERS=1
TGBOT_LOG_LEVEL=info

# Sensitive values should be kept out of repository and put into /etc/tgbot/ or a secrets manager.
# Example (do NOT commit real tokens):
# TGBOT_TOKEN=123456:ABC-DEF1234ghIkl-zyx57W2v1u123ew11
