# Telegram Bot Token (required)
# Obtain from @BotFather on Telegram: https://t.me/BotFather
BOT_TOKEN=your_bot_token_here

# ABA BANK secondary bot token (optional).
# When set, a lightweight chat-only bot instance runs alongside the main bot.
ABA_BOT_TOKEN=

# External API configuration (optional)
API_BASE_URL=https://api.example.com
API_KEY=your_api_key_here

# Bot settings
POLLER_TIMEOUT=10s

# Shared database path used by bot + admin panel
DATABASE_PATH=../shared.db
MIGRATIONS_DIR=./migrations

# Bot identity for heartbeats / admin panel
BOT_NAME=wing-bank
BOT_VERSION=dev
